<Window x:Class="Ecritoire.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:Ecritoire.App"
        Title="Écritoire" Width="1320" Height="860" MinWidth="760" MinHeight="480"
        Icon="Ressources/Icone.png"
        Background="White" FontFamily="{StaticResource Interface}" FontSize="13.5"
        Foreground="{StaticResource Texte}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- Interface v2 de l'app macOS : rail d'icônes, barre latérale claire, page blanche sans cadre, panneau de droite flottant. -->
    <Grid Background="{StaticResource Cadre}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Rail d'icônes, sur le cadre teinté qu'il partage avec la barre de titre -->
        <Border Grid.Column="0" Background="Transparent">
            <DockPanel Margin="0,14,0,14">
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Button Style="{StaticResource BoutonCadre}" Width="36" Height="36" Margin="0,0,0,6" Click="ExportClick" ToolTip="Exporter en PDF ou en Markdown… (Ctrl+E)">
                        <Image Source="{local:Icon share, Size=20}" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource BoutonCadre}" Width="36" Height="36" Click="OpenBinderClick" ToolTip="Ouvrir un classeur… (Ctrl+O)">
                        <Image Source="{local:Icon folder, Size=20}" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <ToggleButton x:Name="RailBinder" Style="{StaticResource BoutonRail}" Click="RailBinderClick" ToolTip="Classeur">
                        <Image Source="{local:Icon books, Size=20, Color=#1F1F1F}" Width="20" Height="20"/>
                    </ToggleButton>
                    <ToggleButton x:Name="RailSearch" Style="{StaticResource BoutonRail}" Click="SearchClick" ToolTip="Rechercher dans les titres et le texte (Ctrl+Maj+F)">
                        <Image Source="{local:Icon search, Size=20, Color=#1F1F1F}" Width="20" Height="20"/>
                    </ToggleButton>
                    <ToggleButton x:Name="RailComments" Style="{StaticResource BoutonRail}" Click="CommentsToggleClick" ToolTip="Commentaires (Ctrl+Maj+C)">
                        <Image Source="{local:Icon comment, Size=20, Color=#1F1F1F}" Width="20" Height="20"/>
                    </ToggleButton>
                    <ToggleButton x:Name="RailChanges" Style="{StaticResource BoutonRail}" Click="RailChangesClick" ToolTip="Modifications depuis l'instantané">
                        <Image Source="{local:Icon clock, Size=20, Color=#1F1F1F}" Width="20" Height="20"/>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barre latérale : classeur ou recherche, plus claire que le cadre, coin arrondi sous la barre de titre -->
        <Border Grid.Column="1" Background="{StaticResource Panneau}" CornerRadius="12,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="56" Margin="16,10,10,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" Click="CollapseSidebarClick" ToolTip="Masquer la barre latérale (Ctrl+\)">
                        <Image Source="{local:Icon sidebar-left, Size=18}" Width="18" Height="18"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" Click="SearchClick" ToolTip="Rechercher (Ctrl+Maj+F)">
                        <Image Source="{local:Icon search, Size=18}" Width="18" Height="18"/>
                    </Button>
                    <Button DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OpenBinderClick" ToolTip="Ouvrir un autre classeur… (Ctrl+O)" Padding="0" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BinderName" Text="Écritoire" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center"/>
                            <Image Source="{local:Icon chevron-down, Size=12, Color=#8A8A8A}" Width="12" Height="12" Margin="7,3,0,0"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <Grid>
                    <DockPanel x:Name="BinderPanel">
                        <Button DockPanel.Dock="Top" Margin="6,2,6,6" Height="36" Click="NewDocumentClick" ToolTip="Nouveau document (Ctrl+N)" HorizontalContentAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Fond" Background="Transparent" CornerRadius="8" Padding="12,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fond" Property="Background" Value="{StaticResource Survol}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{local:Icon compose, Size=18}" Width="18" Height="18" Margin="0,0,12,0"/>
                                <TextBlock Text="Nouveau document" FontSize="14.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Top" Text="Classeur" Foreground="{StaticResource TexteSecondaire}" FontSize="13" Margin="18,10,0,6"/>
                        <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Padding="0,0,0,12"
                                  SelectedItemChanged="TreeSelectionChanged" AllowDrop="True" ContextMenuOpening="TreeContextMenuOpening"
                                  PreviewMouseLeftButtonDown="TreeMouseDown" PreviewMouseMove="TreeMouseMove" DragOver="TreeDragOver" DragLeave="TreeDragLeave" Drop="TreeDrop"
                                  PreviewMouseRightButtonDown="TreeRightMouseDown" KeyDown="TreeKeyDown"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.ContextMenu><ContextMenu/></TreeView.ContextMenu>
                        </TreeView>
                    </DockPanel>
                    <DockPanel x:Name="SearchPanel" Visibility="Collapsed" Background="{StaticResource Panneau}">
                        <Border DockPanel.Dock="Top" Margin="10,2,10,8" Background="White" CornerRadius="8" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                            <DockPanel Margin="10,6">
                                <Image DockPanel.Dock="Left" Source="{local:Icon search, Size=16, Color=#8A8A8A}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBox x:Name="SearchBox" Style="{StaticResource ChampNu}" BorderThickness="0" Background="Transparent" FontSize="14" TextChanged="SearchTextChanged" PreviewKeyDown="SearchKeyDown" VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0" Height="32">
                            <TextBlock x:Name="SearchStatus" Margin="14,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TexteSecondaire}" TextTrimming="CharacterEllipsis"
                                       Text="Titres et texte, sans tenir compte des accents"/>
                        </Border>
                        <ListBox x:Name="SearchResults" Background="Transparent" BorderThickness="0" SelectionChanged="SearchResultChosen" Padding="6,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Fond" Background="Transparent" CornerRadius="8" Padding="8,5" Margin="0,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fond" Property="Background" Value="{StaticResource Survol}"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Fond" Property="Background" Value="{StaticResource Selection}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel Visibility="{Binding TitleVisibility}" Margin="0,6,0,0">
                                            <Image DockPanel.Dock="Left" Source="{local:Icon file, Size=15, Color=#8A8A8A}" Width="15" Height="15" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="{StaticResource TexteSecondaire}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource TexteSecondaire}" Visibility="{Binding LabelVisibility}" Margin="23,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock TextWrapping="Wrap" Margin="23,1,0,0" MaxHeight="84" Visibility="{Binding HitVisibility}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{x:Static local:Theme.Serif}" Foreground="#555555">
                                            <Run Text="{Binding Before, Mode=OneWay}"/><Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold" Background="#8CFFDB4D" Foreground="#1F1F1F"/><Run Text="{Binding After, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
        <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" Width="4" Background="{StaticResource Panneau}" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

        <!-- Zone d'écriture -->
        <DockPanel Grid.Column="3" x:Name="MainArea" Background="White">
            <!-- En-tête : titre, mots, outils -->
            <DockPanel DockPanel.Dock="Top" Height="52" Margin="12,0,10,0" LastChildFill="True">
                <Button x:Name="ExpandSidebarButton" DockPanel.Dock="Left" Style="{StaticResource BoutonIcone}" Click="CollapseSidebarClick" Visibility="Collapsed" ToolTip="Afficher la barre latérale (Ctrl+\)" Margin="0,0,6,0">
                    <Image Source="{local:Icon sidebar-left, Size=18}" Width="18" Height="18"/>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nouvelle version disponible (vérifiée au lancement) -->
                    <Button x:Name="UpdateButton" Style="{StaticResource BoutonAccent}" Padding="10,4" Margin="0,0,10,0" FontSize="12.5" Visibility="Collapsed" Click="UpdateClick"/>
                    <Border Background="#0D000000" CornerRadius="8" Padding="2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ProseButton" Content="Prose" Style="{StaticResource Bascule}" Click="ProseClick" ToolTip="Affichage prose"/>
                            <ToggleButton x:Name="PoemButton" Content="Poème" Style="{StaticResource Bascule}" Click="PoemClick" ToolTip="Affichage poème : versets numérotés, en-tête centré"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <ToggleButton x:Name="CommentsButton" Style="{StaticResource BoutonBascule}" Click="CommentsToggleClick" ToolTip="Afficher les commentaires (Ctrl+Maj+C)">
                            <Image Source="{local:Icon comment, Size=18}" Width="18" Height="18"/>
                        </ToggleButton>
                        <Border x:Name="CommentsBadge" Background="{StaticResource Accent}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-2,0" IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock x:Name="CommentsBadgeText" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ToggleButton x:Name="InspectorButton" Style="{StaticResource BoutonBascule}" Click="InspectorToggleClick" ToolTip="Inspecteur : titre, statut, synopsis, publication (Ctrl+I)">
                        <Image Source="{local:Icon sidebar-right, Size=18}" Width="18" Height="18"/>
                    </ToggleButton>
                    <Button x:Name="MoreButton" Style="{StaticResource BoutonIcone}" Click="MoreClick" ToolTip="Plus">
                        <Image Source="{local:Icon ellipsis, Size=18}" Width="18" Height="18"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Exporter…" InputGestureText="Ctrl+E" Click="ExportClick"/>
                                <MenuItem Header="Commenter la sélection" InputGestureText="Ctrl+Maj+M" Click="CommentClick"/>
                                <MenuItem Header="Créer un instantané (point de comparaison)" Click="TakeSnapshotClick"/>
                                <Separator/>
                                <MenuItem x:Name="AiBarItem" Header="Barre « Demander à l'IA »" IsCheckable="True" Click="AiBarToggleClick"/>
                                <MenuItem x:Name="OutlineItem" Header="Réglette des titres" IsCheckable="True" Click="OutlineToggleClick"/>
                                <Separator/>
                                <MenuItem Header="Zoomer" InputGestureText="Ctrl++" Click="ZoomInClick"/>
                                <MenuItem Header="Dézoomer" InputGestureText="Ctrl+−" Click="ZoomOutClick"/>
                                <MenuItem Header="Taille réelle" InputGestureText="Ctrl+0" Click="ZoomResetMenuClick"/>
                                <Separator/>
                                <MenuItem Header="Ouvrir un classeur…" InputGestureText="Ctrl+O" Click="OpenBinderClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentTitle" FontWeight="Bold" FontSize="15" Text="" TextTrimming="CharacterEllipsis" MaxWidth="460" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WordCount" Margin="12,0,0,0" FontSize="13" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ZoomLabel" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonUp="ZoomResetClick" ToolTip="Revenir à 100 % (Ctrl+0)"/>
                    <TextBlock x:Name="SaveState" Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    <TextBlock x:Name="DocumentPath" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>

            <!-- Bandeau : modifications depuis l'instantané -->
            <Border x:Name="ChangesBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="16,0,16,8" Background="{StaticResource Panneau}" CornerRadius="10" BorderBrush="{StaticResource Filet}" BorderThickness="1">
                <DockPanel Margin="12,6">
                    <Image DockPanel.Dock="Left" Source="{local:Icon changes, Size=16}" Width="16" Height="16" Margin="0,0,10,0"/>
                    <Button DockPanel.Dock="Right" Content="Ignorer" Style="{StaticResource BoutonPlat}" Margin="6,0,0,0" Click="DiscardSnapshotClick" ToolTip="La version actuelle devient la référence"/>
                    <Button DockPanel.Dock="Right" Content="Voir les modifications" Style="{StaticResource BoutonPlat}" Click="EnterReviewClick"/>
                    <TextBlock x:Name="ChangesText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <!-- Barre du mode « Modifications » -->
            <Border x:Name="ReviewBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="White" CornerRadius="10" BorderBrush="{StaticResource Filet}" BorderThickness="1" HorizontalAlignment="Center" Padding="10,5" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{local:Icon changes, Size=16, Color=#33A85C}" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ReviewText" MinWidth="150" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BoutonIcone}" Click="PreviousChangeClick" ToolTip="Précédente (Alt+Haut)"><Image Source="{local:Icon chevron-up, Size=16}" Width="16" Height="16"/></Button>
                    <Button Style="{StaticResource BoutonIcone}" Click="NextChangeClick" ToolTip="Suivante (Alt+Bas)"><Image Source="{local:Icon chevron-down, Size=16}" Width="16" Height="16"/></Button>
                    <Button Content="Accepter" Style="{StaticResource BoutonPlat}" Margin="8,0,4,0" Background="#33A85C" BorderBrush="#33A85C" Foreground="White" Click="AcceptChangeClick" ToolTip="Garder cette modification"/>
                    <Button Content="Refuser" Style="{StaticResource BoutonPlat}" Click="RejectChangeClick" ToolTip="Revenir au texte d'avant pour ce passage"/>
                    <Button Content="Tout accepter" Style="{StaticResource BoutonPlat}" Margin="12,0,4,0" Click="AcceptAllClick"/>
                    <Button Content="Tout refuser" Style="{StaticResource BoutonPlat}" Click="RejectAllClick"/>
                    <Button Content="Terminer" Style="{StaticResource BoutonPlat}" Margin="12,0,0,0" Click="ExitReviewClick" ToolTip="Échap"/>
                </StackPanel>
            </Border>

            <Grid x:Name="EditorArea">
                <!-- L'éditeur occupe toute la zone : la barre de défilement est au bord de la fenêtre, la colonne de texte
                     est centrée par les marges intérieures (calculées dans ApplyLayout). -->
                <Border x:Name="PageBorder" Background="White"/>
                <ae:TextEditor x:Name="Editor" WordWrap="True" ShowLineNumbers="False" Background="White"
                               HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>

                <!-- Réglette à gauche de la colonne : un trait par titre ; celui de la section courante est plus long et
                     noir. Survol : aperçu de la section ; clic : défilement animé jusqu'à elle. -->
                <StackPanel x:Name="OutlineRuler" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Visibility="Collapsed"
                            MouseLeave="OutlineMouseLeave"/>
                <Popup x:Name="OutlinePopup" AllowsTransparency="True" Placement="Right" HorizontalOffset="6" StaysOpen="True" IsHitTestVisible="False" PopupAnimation="Fade">
                    <Border Margin="10" Background="White" CornerRadius="10" BorderBrush="{StaticResource Filet}" BorderThickness="1" Padding="13,10" MaxWidth="300">
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.10" Color="Black"/></Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="OutlinePopupTitle" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OutlinePopupExcerpt" FontSize="12.5" Foreground="{StaticResource TexteSecondaire}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="WordEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Barre « Demander à l'IA… » : prépare une demande pour Claude (document, sélection, consignes), la copie
                     dans le presse-papiers et prend un instantané pour voir ensuite ses modifications. -->
                <Border x:Name="AiBar" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,18" Visibility="Collapsed"
                        Background="White" CornerRadius="16" BorderBrush="{StaticResource Filet}" BorderThickness="1" Padding="16,11,10,8">
                    <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.08" Color="Black"/></Border.Effect>
                    <StackPanel>
                        <Grid>
                            <TextBox x:Name="AiBox" Style="{StaticResource ChampNu}" BorderThickness="0" Background="Transparent" FontSize="14.5" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto" Padding="0,1" PreviewKeyDown="AiKeyDown" TextChanged="AiTextChanged"/>
                            <TextBlock x:Name="AiPlaceholder" Text="Demander à l'IA…" IsHitTestVisible="False" Foreground="{StaticResource TexteSecondaire}" FontSize="14.5" Margin="2,1,0,0"/>
                        </Grid>
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="AiPlusButton" DockPanel.Dock="Left" Style="{StaticResource BoutonIcone}" Width="28" Height="28" Margin="-7,0,0,0" Click="AiPlusClick" ToolTip="Plus d'options">
                                <Image Source="{local:Icon plus, Size=16}" Width="16" Height="16"/>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Commenter la sélection" InputGestureText="Ctrl+Maj+M" Click="CommentClick"/>
                                        <MenuItem x:Name="AiSendCommentsItem" Header="Envoyer les commentaires à Claude" Click="CopyPromptClick"/>
                                        <MenuItem Header="Enregistrer la demande dans un fichier…" Click="AiSaveClick"/>
                                        <Separator/>
                                        <MenuItem Header="Créer un instantané (point de comparaison)" Click="TakeSnapshotClick"/>
                                        <MenuItem Header="Masquer cette barre" Click="AiBarToggleClick"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="AiSendButton" DockPanel.Dock="Right" Style="{StaticResource BoutonRond}" IsEnabled="False" Click="AiSendClick"
                                    ToolTip="Copier la demande pour Claude (Entrée) ; un instantané est gardé pour voir ensuite ses modifications">
                                <Image Source="{local:Icon paper-plane, Size=15, Color=#FFFFFF}" Width="15" Height="15"/>
                            </Button>
                            <TextBlock x:Name="AiContext" VerticalAlignment="Center" Margin="4,0,10,0" FontSize="12" Foreground="{StaticResource TexteSecondaire}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <Image Source="Ressources/Icone.png" Width="96" Height="96" Margin="0,0,0,14"/>
                    <TextBlock Text="Écritoire" FontSize="30" HorizontalAlignment="Center" x:Name="WelcomeTitle"/>
                    <TextBlock Text="Un classeur est un simple dossier de fichiers Markdown. Choisissez un classeur existant, ou un dossier vide pour commencer."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TexteSecondaire}" Margin="0,10,0,16"/>
                    <Button Content="Ouvrir un classeur…" HorizontalAlignment="Center" Style="{StaticResource BoutonPlat}" Padding="16,6" Click="OpenBinderClick"/>
                </StackPanel>

                <!-- Panneau de droite flottant : commentaires ou inspecteur -->
                <Border x:Name="RightPanel" Width="330" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,4,12,12"
                        Background="White" CornerRadius="12" BorderBrush="{StaticResource Filet}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.08" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <DockPanel x:Name="CommentsPanel">
                            <Border DockPanel.Dock="Top" Height="46" BorderBrush="{StaticResource Filet}" BorderThickness="0,0,0,1">
                                <DockPanel Margin="10,0,8,0">
                                    <Button x:Name="ArchiveBack" DockPanel.Dock="Left" Style="{StaticResource BoutonIcone}" Width="26" Height="26" Click="ShowOpenCommentsClick" ToolTip="Revenir aux commentaires en cours" Visibility="Collapsed">
                                        <Image Source="{local:Icon chevron-left, Size=14}" Width="14" Height="14"/>
                                    </Button>
                                    <Image x:Name="CommentsHeaderIcon" DockPanel.Dock="Left" Source="{local:Icon comment, Size=17}" Width="17" Height="17" Margin="4,0,9,0"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" Width="26" Height="26" Click="CommentsToggleClick" ToolTip="Masquer le volet (Ctrl+Maj+C)">
                                        <Image Source="{local:Icon close, Size=14}" Width="14" Height="14"/>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="CommentsHeader" Text="Commentaires" FontWeight="Bold" FontSize="14.5"/>
                                        <Border x:Name="CommentsCountPill" Background="{StaticResource Selection}" CornerRadius="8" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="CommentsCount" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TexteSecondaire}"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border DockPanel.Dock="Bottom" Height="36" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0">
                                <DockPanel Margin="14,0">
                                    <TextBlock x:Name="ArchiveLink" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}" Cursor="Hand" MouseLeftButtonUp="ArchiveLinkClick" FontSize="12.5"/>
                                    <TextBlock x:Name="CommentsFooter" VerticalAlignment="Center" Foreground="{StaticResource TexteSecondaire}" FontSize="12.5"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ClaudeCard" DockPanel.Dock="Top" Margin="12,12,12,6" Padding="8" Background="White" CornerRadius="10" BorderBrush="{StaticResource Filet}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" x:Name="ClaudeMenuButton" Style="{StaticResource BoutonIcone}" Click="ClaudeMenuClick" Margin="4,0,0,0">
                                            <Image Source="{local:Icon ellipsis, Size=16}" Width="16" Height="16"/>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem x:Name="CopyPromptItem" Header="Envoyer (copier le prompt)" Click="CopyPromptClick"/>
                                                    <MenuItem x:Name="SavePromptItem" Header="Envoyer (enregistrer le prompt dans un fichier)…" Click="SavePromptClick"/>
                                                    <Separator/>
                                                    <MenuItem Header="Créer un instantané (point de comparaison)" Click="TakeSnapshotClick"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button x:Name="SendButton" Style="{StaticResource BoutonPlat}" Padding="8,6" Click="CopyPromptClick"
                                                ToolTip="Copie un seul prompt avec tous les commentaires en cours et le texte intégral, garde un instantané du texte, puis archive ces commentaires"/>
                                    </DockPanel>
                                    <DockPanel x:Name="SentNote" Margin="2,8,2,0" Visibility="Collapsed">
                                        <TextBlock DockPanel.Dock="Right" Text="Voir" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12" Cursor="Hand" MouseLeftButtonUp="ArchiveLinkClick" Margin="6,0,0,0"/>
                                        <TextBlock x:Name="SentText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TexteSecondaire}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="SendHint" Margin="2,8,2,0" Text="Les commentaires envoyés passent en archive." FontSize="12" Foreground="{StaticResource TexteSecondaire}"/>
                                    <DockPanel x:Name="PendingNote" Margin="2,8,2,0" Visibility="Collapsed">
                                        <TextBlock x:Name="PendingLink" DockPanel.Dock="Right" Text="Voir" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12" Cursor="Hand" MouseLeftButtonUp="PendingLinkClick" Margin="6,0,0,0"/>
                                        <TextBlock x:Name="PendingText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TexteSecondaire}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <ScrollViewer x:Name="CommentsScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CommentsList" Margin="12,4,12,12"/>
                            </ScrollViewer>
                        </DockPanel>

                        <DockPanel x:Name="InspectorPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="InspectorFields" Margin="18,16,18,16">
                                    <!-- Liens : [[…]] du document -->
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" Width="26" Height="26" Click="InspectorToggleClick" ToolTip="Masquer le panneau (Ctrl+I)">
                                            <Image Source="{local:Icon close, Size=14}" Width="14" Height="14"/>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BoutonIcone}" Width="26" Height="26" Click="AddLinkClick" ToolTip="Insérer un lien [[…]] au curseur">
                                            <Image Source="{local:Icon plus, Size=14}" Width="14" Height="14"/>
                                        </Button>
                                        <TextBlock Text="Liens" Foreground="{StaticResource TexteSecondaire}" FontSize="13.5" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel x:Name="LinksList" Margin="-8,0,-8,0"/>
                                    <TextBlock x:Name="LinksMore" Foreground="{StaticResource TexteSecondaire}" FontSize="12.5" Cursor="Hand" Margin="0,4,0,0" MouseLeftButtonUp="LinksMoreClick" Visibility="Collapsed"/>

                                    <!-- Rétroliens : documents du classeur qui pointent vers celui-ci -->
                                    <TextBlock Text="Rétroliens" Foreground="{StaticResource TexteSecondaire}" FontSize="13.5" Margin="0,16,0,6"/>
                                    <StackPanel x:Name="BacklinksList" Margin="-8,0,-8,0"/>
                                    <TextBlock x:Name="BacklinksMore" Foreground="{StaticResource TexteSecondaire}" FontSize="12.5" Cursor="Hand" Margin="0,4,0,0" MouseLeftButtonUp="BacklinksMoreClick" Visibility="Collapsed"/>

                                    <Border Height="1" Background="{StaticResource Filet}" Margin="0,16,0,14"/>
                                    <TextBlock Text="Métadonnées" Foreground="{StaticResource TexteSecondaire}" FontSize="13.5" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{local:Icon text-size, Size=16, Color=#8A8A8A}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Titre" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="TitleBox" Style="{StaticResource ChampNu}" BorderThickness="0" Background="Transparent" Padding="0,8" FontSize="13.5" TextChanged="InspectorChanged" VerticalContentAlignment="Center"/>

                                        <Image Grid.Row="1" Source="{local:Icon status, Size=16, Color=#8A8A8A}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Statut" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="2" x:Name="StatusBox" Margin="0,5" HorizontalAlignment="Left" MinWidth="120" SelectionChanged="InspectorChanged"/>

                                        <Image Grid.Row="2" Source="{local:Icon align-left, Size=16, Color=#8A8A8A}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,9,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Synopsis" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Top" Margin="6,8,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="SynopsisBox" Style="{StaticResource ChampNu}" BorderThickness="0" Background="Transparent" Padding="0,8" FontSize="13.5" TextWrapping="Wrap" AcceptsReturn="False"
                                                 MaxHeight="180" VerticalScrollBarVisibility="Auto" TextChanged="InspectorChanged"/>

                                        <Image Grid.Row="3" Source="{local:Icon globe, Size=16, Color=#8A8A8A}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Wiki" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <CheckBox Grid.Row="3" Grid.Column="2" x:Name="PublishBox" Content="Publier" Margin="0,8" VerticalAlignment="Center" Click="InspectorChanged"/>

                                        <Image Grid.Row="4" Source="{local:Icon file, Size=16, Color=#8A8A8A}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Fichier" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" x:Name="FileNameText" TextTrimming="CharacterEllipsis" Margin="0,8" VerticalAlignment="Center"/>

                                        <Image Grid.Row="5" Source="{local:Icon align-left, Size=16, Color=#8A8A8A}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Mots" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" x:Name="FileWordsText" Margin="0,8" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                        <TextBlock x:Name="InspectorEmpty" Text="Aucun document" Foreground="{StaticResource TexteSecondaire}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
