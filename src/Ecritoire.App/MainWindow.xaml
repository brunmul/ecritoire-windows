<Window x:Class="Ecritoire.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Écritoire" Width="1280" Height="820" MinWidth="760" MinHeight="480"
        Icon="Ressources/Icone.png"
        Background="{StaticResource Entete}" FontFamily="{StaticResource Interface}" FontSize="13"
        Foreground="{StaticResource Texte}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Barre d'outils -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Filet}" BorderThickness="0,0,0,1" Background="{StaticResource Entete}">
            <DockPanel Margin="16,0,12,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="DocumentTitle" FontWeight="SemiBold" Text="Écritoire" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                    <TextBlock x:Name="DocumentPath" FontSize="11" Foreground="{StaticResource TexteSecondaire}" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#0F000000" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ProseButton" Content="Prose" Style="{StaticResource Bascule}" Click="ProseClick" ToolTip="Affichage prose"/>
                        <ToggleButton x:Name="PoemButton" Content="Poème" Style="{StaticResource Bascule}" Click="PoemClick" ToolTip="Affichage poème : versets numérotés, en-tête centré"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Classeur / recherche -->
            <Border Grid.Column="0" Background="{StaticResource Panneau}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="40" BorderBrush="{StaticResource Filet}" BorderThickness="0,0,0,1">
                        <DockPanel Margin="12,0,6,0">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE8F1;" FontFamily="{StaticResource Glyphes}" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Content="&#xE8DA;" Style="{StaticResource BoutonIcone}" Click="OpenBinderClick" ToolTip="Ouvrir un classeur… (Ctrl+O)"/>
                            <Button DockPanel.Dock="Right" Content="&#xE721;" Style="{StaticResource BoutonIcone}" Click="SearchClick" ToolTip="Rechercher dans les titres et le texte (Ctrl+Maj+F)"/>
                            <TextBlock x:Name="BinderName" Text="Écritoire" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Padding="4,6,4,6"
                                  SelectedItemChanged="TreeSelectionChanged"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        <DockPanel x:Name="SearchPanel" Visibility="Collapsed" Background="{StaticResource Panneau}">
                            <Border DockPanel.Dock="Top" Margin="10,10,10,6" Background="White" CornerRadius="7" BorderBrush="{StaticResource Filet}" BorderThickness="1">
                                <DockPanel Margin="8,4">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource Glyphes}" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" TextChanged="SearchTextChanged" PreviewKeyDown="SearchKeyDown"/>
                                </DockPanel>
                            </Border>
                            <TextBlock x:Name="SearchStatus" DockPanel.Dock="Bottom" Margin="12,6" FontSize="11" Foreground="{StaticResource TexteSecondaire}"
                                       Text="Titres et texte, sans tenir compte des accents"/>
                            <ListBox x:Name="SearchResults" Background="Transparent" BorderThickness="0" SelectionChanged="SearchResultChosen"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,3">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Visibility="{Binding TitleVisibility}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}" FontSize="10.5" Foreground="{StaticResource TexteSecondaire}" Visibility="{Binding TitleVisibility}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource TexteSecondaire}" Visibility="{Binding LabelVisibility}" Margin="10,2,0,0"/>
                                            <TextBlock TextWrapping="Wrap" Margin="10,1,0,0" MaxHeight="72" Visibility="{Binding HitVisibility}">
                                                <Run Text="{Binding Before, Mode=OneWay}"/><Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold" Background="#8CFFDB4D"/><Run Text="{Binding After, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource Filet}" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Bureau et page -->
            <Border Grid.Column="2" Background="{StaticResource Bureau}">
                <Grid>
                    <Border x:Name="PageBorder" Background="{StaticResource Page}" HorizontalAlignment="Center" Margin="0,12,0,0"
                            BorderBrush="{StaticResource Filet}" BorderThickness="1,1,1,0">
                        <ae:TextEditor x:Name="Editor" WordWrap="True" ShowLineNumbers="False" Background="Transparent"
                                       HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
                    </Border>
                    <StackPanel x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <Image Source="Ressources/Icone.png" Width="96" Height="96" Margin="0,0,0,14"/>
                        <TextBlock Text="Écritoire" FontSize="30" HorizontalAlignment="Center" x:Name="WelcomeTitle"/>
                        <TextBlock Text="Un classeur est un simple dossier de fichiers Markdown. Choisissez un classeur existant, ou un dossier vide pour commencer."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TexteSecondaire}" Margin="0,10,0,16"/>
                        <Button Content="Ouvrir un classeur…" HorizontalAlignment="Center" Padding="16,6" Click="OpenBinderClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Barre d'état -->
        <Border Grid.Row="2" Background="{StaticResource Entete}" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE738;" Style="{StaticResource BoutonIcone}" Height="22" FontSize="10" Click="ZoomOutClick" ToolTip="Dézoomer (Ctrl+−)"/>
                    <TextBlock x:Name="ZoomLabel" Text="100 %" Width="44" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TexteSecondaire}" MouseLeftButtonUp="ZoomResetClick" ToolTip="Revenir à 100 % (Ctrl+0)"/>
                    <Button Content="&#xE710;" Style="{StaticResource BoutonIcone}" Height="22" FontSize="10" Click="ZoomInClick" ToolTip="Zoomer (Ctrl++)"/>
                    <TextBlock x:Name="WordCount" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TexteSecondaire}"/>
                </StackPanel>
                <TextBlock x:Name="SaveState" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TexteSecondaire}"/>
                <TextBlock/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
