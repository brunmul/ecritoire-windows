<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Construction possible depuis macOS ou Linux (dotnet publish) : seules les références Windows sont nécessaires. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Ecritoire</AssemblyName>
    <RootNamespace>Ecritoire.App</RootNamespace>
    <Product>Écritoire</Product>
    <Version>0.3.2</Version>
    <Copyright>GPL-3.0-or-later</Copyright>
    <ApplicationIcon>Ressources\Ecritoire.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Un seul fichier .exe autonome (aucun .NET à installer sur le PC). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Tout dans l’exe, y compris la police de repli de QuestPDF (extraite au premier lancement). -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <ProjectReference Include="..\Ecritoire.Core\Ecritoire.Core.csproj" />
    <ProjectReference Include="..\Ecritoire.Pdf\Ecritoire.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Polices libres (licence SIL OFL) : Libre Bodoni et Hanken Grotesk. -->
    <Resource Include="Polices\*.ttf" />
    <Resource Include="Ressources\Icone.png" />
    <Resource Include="Ressources\Icones\*.svg" />
  </ItemGroup>

</Project>
